# Production environment for the Dokploy deployment (compose.prod.yaml).
# Copy these values into the Dokploy application "Environment" tab.
# Do NOT commit real secrets — this file only documents the required keys.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=fantasy
POSTGRES_USER=fantasy
# REQUIRED: pick a strong, unique password (no default is provided on purpose).
POSTGRES_PASSWORD=change-me-to-a-strong-secret

# --- Public domain ----------------------------------------------------------
# The hostname Traefik routes to the frontend. Must have a DNS A record
# pointing at the VPS (145.239.74.111) before the TLS certificate can issue.
FRONTEND_DOMAIN=fantasy.smokebeliu.com
