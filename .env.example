# Local PostgreSQL
POSTGRES_DB=fantasy
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=fantasy
POSTGRES_PORT=5432

# Application database URL for migrations and persistence.
# Use host "localhost" when running tools from the host, or "postgres" when
# running inside the Compose network. Compose services set this automatically.
DATABASE_URL=postgresql+psycopg://fantasy:fantasy@localhost:5432/fantasy

# Discovery defaults
FANTASY_TOURNAMENT=russia
DISCOVERY_DIRECTORY=discovery

# Service ports (host side)
API_PORT=8000
FRONTEND_PORT=3000

# Nightly refresh of every league whose current season is already imported.
# The API process sleeps until this local hour and then enqueues the same
# current-season jobs the admin button would. Catalogued-only leagues and
# finished historical imports are left alone.
NIGHTLY_REFRESH_ENABLED=true
NIGHTLY_REFRESH_HOUR=3
NIGHTLY_REFRESH_MINUTE=0
NIGHTLY_REFRESH_TZ=Europe/Moscow
NIGHTLY_REFRESH_CATCHUP_HOURS=3
